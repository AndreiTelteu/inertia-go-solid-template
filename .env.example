# ./artisan dev uses Vite HMR and the bundled Go rebuild watcher.
# Names the executable (build/<name>), the systemd unit and the process shown in htop/ps.
APP_NAME=inertia-go-solid-template
APP_ENV=development
APP_ADDR=127.0.0.1:8080
# Production needs a persistent 32-byte hex key for encrypted session cookies.
# Generate one safely in .env with: ./artisan key:generate
APP_KEY=
